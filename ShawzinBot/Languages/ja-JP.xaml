<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="WindowTitle">ショウジン自動演奏ツール</sys:String>
    <sys:String x:Key="MidiInputDevice">MIDI入力デバイス</sys:String>
    <sys:String x:Key="MidiTracks">MIDIトラック（音階）</sys:String>
    <sys:String x:Key="SettingsTitle">設定</sys:String>
    <sys:String x:Key="Vibrato">ヴィブラート</sys:String>
